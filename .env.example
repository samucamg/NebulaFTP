# ==============================================
# NEBULA FTP - CONFIGURAÇÃO
# Copie para .env e preencha:
#   cp .env.example .env
# ==============================================

# ============= TELEGRAM =============
# Obtenha em: https://my.telegram.org
API_ID=12345678
API_HASH=abc123def456789...

# Crie bots em: https://t.me/BotFather
# A versão Community usa apenas o 1º token (Multi-Bot é recurso Pro)
BOT_TOKENS=1234567890:AABBccDDee...,9876543210:AAFFggHH...

# ID do canal principal (copie de @userinfobot)
# Formato: -100XXXXXXXXXX
CHAT_ID=-1001234567890

# ============= DATABASE =============
# DB_TYPE pode ser 'sqlite' (padrão, sem instalação) ou 'mongodb'
DB_TYPE=sqlite

# Arquivo do banco SQLite (quando DB_TYPE=sqlite)
DB_FILE=nebula.db

# Para MongoDB (quando DB_TYPE=mongodb):
# MongoDB Atlas (cloud): mongodb+srv://user:pass@cluster.mongodb.net/ftp
# MongoDB Local: mongodb://localhost:27017
MONGODB=mongodb://localhost:27017

# ============= SERVIDORES =============
# Interface de escuta (0.0.0.0 = todas). Se clientes usarem PASV de
# outra máquina, coloque aqui o IP (LAN ou público) do servidor.
HOST=0.0.0.0

# Porta do servidor FTP
PORT=2121

# Porta do servidor SFTP (SSH)
SFTP_PORT=2222

# Porta do painel web de administração
WEB_PORT=8080

# Senha para proteger o painel web (Basic Auth). Vazio = painel sem senha.
WEB_ADMIN_PASSWORD=

# ============= PERFORMANCE =============
# Número de workers simultâneos (recomendado: 4-8)
MAX_WORKERS=4

# Tamanho dos chunks em MB (64MB = ótimo para Telegram)
CHUNK_SIZE_MB=64

# Tentativas de retry em caso de erro
MAX_RETRIES=5

# Tempo máximo de staging em segundos (1 hora)
MAX_STAGING_AGE=3600

# ============= LOGGING =============
# Níveis: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
