# --- Telegram (um bot, um canal) ---
API_ID=
API_HASH=
# O token do seu bot (@BotFather). Só um bot. Ele precisa ser administrador do canal.
BOT_TOKENS=
# ID do canal (ex.: -1001234567890)
CHAT_ID=

# --- Acesso (o Docker também usa SFTP_PORT e WEB_PORT daqui) ---
HOST=0.0.0.0
SFTP_PORT=2222
WEB_PORT=8082
WEB_ADMIN_USER=admin
# Obrigatória na primeira execução (cria o admin)
WEB_ADMIN_PASSWORD=

# --- Armazenamento local ---
DB_FILE=data/nebula.db
DATA_DIR=data
CHUNK_SIZE_MB=100
# segundos
MAX_STAGING_AGE=3600
CACHE_MAX_AGE=3600
SFTP_HOST_KEY=data/sftp_host_key
LOG_LEVEL=INFO
